<?xml version="1.0"?>
<ruleset name="laravel-powerbi">
    <description>PSR-12 where it does not conflict with Pint, plus complexity and debugging checks Pint does not make.</description>

    <rule ref="PSR12">
        <!-- Pint's Laravel preset owns these, and formats them the opposite way. -->
        <exclude name="Generic.Files.LineLength" />
        <exclude name="PSR12.Classes.ClassInstantiation.MissingParentheses" />
        <exclude name="PSR12.Operators.OperatorSpacing" />
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine" />
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore" />
    </rule>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="15" />
            <property name="absoluteComplexity" value="43" />
        </properties>
    </rule>

    <rule ref="Generic.Metrics.NestingLevel">
        <properties>
            <property name="nestingLevel" value="5" />
            <property name="absoluteNestingLevel" value="7" />
        </properties>
    </rule>

    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="dd" value="null" />
                <element key="dump" value="null" />
                <element key="ray" value="null" />
                <element key="var_dump" value="null" />
                <element key="print_r" value="null" />
            </property>
        </properties>
    </rule>

    <arg name="extensions" value="php" />
    <arg name="colors" />
    <arg value="sp" />

    <file>config</file>
    <file>database</file>
    <file>src</file>
    <file>tests</file>
</ruleset>
